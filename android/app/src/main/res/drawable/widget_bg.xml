<?xml version="1.0" encoding="utf-8"?>
<!-- Koyu, yarı-saydam, yuvarlatılmış köşeli widget arka planı -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Yarı-saydam koyu gradient -->
    <gradient
        android:startColor="#CC1A1A2E"
        android:centerColor="#CC16213E"
        android:endColor="#CC0F3460"
        android:angle="135" />

    <!-- Yuvarlatılmış köşeler -->
    <corners android:radius="20dp" />

    <!-- İnce kenarlık -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

</shape>
