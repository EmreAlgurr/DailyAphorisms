<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 geniş widget layout — koyu glassmorphism arka plan -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <!-- Tırnak ikonu -->
    <TextView
        android:id="@+id/quote_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="❝"
        android:textSize="22sp"
        android:textColor="#80FFFFFF" />

    <!-- Söz metni — esnek, uzun sözler için scrollable değil ama maxLines yeterli -->
    <TextView
        android:id="@+id/quote_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/quote_icon"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:text="Bir kategori seçin…"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.35"
        android:maxLines="6"
        android:ellipsize="end" />

    <!-- Yazar adı -->
    <TextView
        android:id="@+id/quote_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/quote_text"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text=""
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-light"
        android:textStyle="italic"
        android:maxLines="1"
        android:ellipsize="end" />

</RelativeLayout>
